<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SPIKE Prime Web Controller - Diswoe SW-01</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --border-color: #334155;
      --accent-color: #3b82f6;
      --accent-hover: #2563eb;
      --danger-color: #ef4444;
      --danger-hover: #dc2626;
      --success-color: #10b981;
      --warning-color: #f59e0b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      padding: 20px;
      min-height: 100vh;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 1px solid var(--border-color);
    }

    h1 {
      font-size: 1.5rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .status-badge {
      font-size: 0.8rem;
      padding: 4px 10px;
      border-radius: 9999px;
      background-color: var(--border-color);
      color: var(--text-muted);
      font-weight: 600;
    }

    .status-badge.connected {
      background-color: rgba(16, 185, 129, 0.2);
      color: var(--success-color);
      border: 1px solid var(--success-color);
    }

    .status-badge.disconnected {
      background-color: rgba(239, 68, 68, 0.2);
      color: var(--danger-color);
      border: 1px solid var(--danger-color);
    }

    .grid-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
      margin-bottom: 20px;
    }

    .card {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }

    .card-title {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 15px;
      color: var(--text-main);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .btn {
      background-color: var(--accent-color);
      color: white;
      border: none;
      padding: 10px 16px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s, transform 0.1s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn:hover {
      background-color: var(--accent-hover);
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-danger {
      background-color: var(--danger-color);
    }

    .btn-danger:hover {
      background-color: var(--danger-hover);
    }

    .btn-lg {
      width: 100%;
      padding: 16px;
      font-size: 1.2rem;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    .control-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 5px;
    }

    select, input[type="range"], input[type="number"] {
      width: 100%;
      padding: 8px 12px;
      background-color: var(--bg-color);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      color: var(--text-main);
      outline: none;
    }

    .joystick-display {
      display: flex;
      justify-content: space-around;
      margin-top: 15px;
    }

    .joystick-container {
      width: 120px;
      height: 120px;
      background-color: var(--bg-color);
      border-radius: 50%;
      border: 2px solid var(--border-color);
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .joystick-handle {
      width: 30px;
      height: 30px;
      background-color: var(--accent-color);
      border-radius: 50%;
      position: absolute;
      transform: translate(0, 0);
      box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
    }

    .gauge-container {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .gauge {
      background-color: var(--bg-color);
      border-radius: 6px;
      padding: 10px;
      border: 1px solid var(--border-color);
    }

    .gauge-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      margin-bottom: 5px;
    }

    .bar-bg {
      height: 10px;
      background-color: var(--border-color);
      border-radius: 5px;
      overflow: hidden;
      position: relative;
    }

    .bar-fill {
      height: 100%;
      background-color: var(--accent-color);
      width: 0%;
      transition: width 0.1s linear;
    }

    .bar-fill.warning {
      background-color: var(--danger-color);
    }

    .distance-alert {
      padding: 10px;
      border-radius: 6px;
      text-align: center;
      font-weight: bold;
      margin-top: 10px;
      background-color: rgba(16, 185, 129, 0.1);
      color: var(--success-color);
      border: 1px solid var(--success-color);
    }

    .distance-alert.active {
      background-color: rgba(239, 68, 68, 0.2);
      color: var(--danger-color);
      border: 1px solid var(--danger-color);
      animation: pulse 1s infinite;
    }

    @keyframes pulse {
      0% { opacity: 1; }
      50% { opacity: 0.5; }
      100% { opacity: 1; }
    }

    .logs-container {
      background-color: var(--bg-color);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      height: 150px;
      overflow-y: auto;
      padding: 10px;
      font-family: monospace;
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .log-entry {
      margin-bottom: 4px;
    }

    .log-entry.error { color: var(--danger-color); }
    .log-entry.info { color: var(--accent-color); }
    .log-entry.success { color: var(--success-color); }

    .tabs {
      display: flex;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 20px;
    }

    .tab-btn {
      padding: 10px 20px;
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-weight: 600;
      border-bottom: 2px solid transparent;
    }

    .tab-btn.active {
      color: var(--accent-color);
      border-bottom-color: var(--accent-color);
    }

    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    .mapping-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .btn-map-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px;
      background: var(--bg-color);
      border: 1px solid var(--border-color);
      border-radius: 6px;
    }

    .code-block {
      background-color: #000;
      color: #00ff00;
      padding: 12px;
      border-radius: 6px;
      font-family: monospace;
      font-size: 0.8rem;
      max-height: 200px;
      overflow-y: auto;
      white-space: pre-wrap;
    }
  </style>
</head>
<body>

  <header>
    <h1>🤖 SPIKE Prime Controller</h1>
    <div style="display: flex; gap: 10px; align-items: center;">
      <span id="hub-status" class="status-badge disconnected">HUB BLE: Desconectado</span>
      <span id="gamepad-status" class="status-badge disconnected">Mando: Desconectado</span>
    </div>
  </header>

  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('control')">Panel de Control</button>
    <button class="tab-btn" onclick="switchTab('config')">Mapeo Mando</button>
    <button class="tab-btn" onclick="switchTab('diag')">Diagnóstico & Bridge Script</button>
  </div>

  <!-- TAB CONTROL -->
  <div id="tab-control" class="tab-content active">
    <div class="grid-container">
      
      <!-- Conexiones y Mando -->
      <div class="card">
        <div class="card-title">
          <span>Dispositivos</span>
          <span id="battery-level" style="font-size:0.8rem; color:var(--text-muted)">Batería: --</span>
        </div>
        <div class="control-group">
          <button id="btn-connect-hub" class="btn" style="width:100%; margin-bottom: 10px;" onclick="connectHub()">
            Conectar SPIKE Prime (BLE)
          </button>
          <button id="btn-connect-gamepad" class="btn" style="width:100%;" onclick="toggleGamepadDetection()">
            Buscar Mando Diswoe SW-01
          </button>
        </div>
        <div class="control-group">
          <label>Modo de Velocidad Máxima</label>
          <select id="speed-mode" onchange="updateSpeedMode(this.value)">
            <option value="0.4">Lento (40%)</option>
            <option value="0.7" selected>Normal (70%)</option>
            <option value="1.0">Rápido (100%)</option>
          </select>
        </div>
        <div class="control-group">
          <label><input type="checkbox" id="auto-brake-check" checked> Frenado Automático por Obstáculo</label>
        </div>
      </div>

      <!-- Estado Joysticks -->
      <div class="card">
        <div class="card-title">Joysticks en Tiempo Real</div>
        <div class="joystick-display">
          <div style="text-align: center;">
            <label>Conducción (Izq)</label>
            <div class="joystick-container">
              <div id="stick-left" class="joystick-handle"></div>
            </div>
          </div>
          <div style="text-align: center;">
            <label>Mecanismo E (Der)</label>
            <div class="joystick-container">
              <div id="stick-right" class="joystick-handle"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Motores y Sensores -->
      <div class="card">
        <div class="card-title">Telemetría de Motores</div>
        <div class="gauge-container">
          <div class="gauge">
            <div class="gauge-header">
              <span>Tracción Izq (Motores A y C)</span>
              <span id="val-motor-left">0%</span>
            </div>
            <div class="bar-bg"><div id="bar-motor-left" class="bar-fill"></div></div>
          </div>
          <div class="gauge">
            <div class="gauge-header">
              <span>Tracción Der (Motores B y D)</span>
              <span id="val-motor-right">0%</span>
            </div>
            <div class="bar-bg"><div id="bar-motor-right" class="bar-fill"></div></div>
          </div>
          <div class="gauge">
            <div class="gauge-header">
              <span>Mecanismo Superior (Motor E)</span>
              <span id="val-motor-e">0%</span>
            </div>
            <div class="bar-bg"><div id="bar-motor-e" class="bar-fill"></div></div>
          </div>
        </div>
      </div>

      <!-- Sensor de Distancia -->
      <div class="card">
        <div class="card-title">Sensor de Distancia (Puerto F)</div>
        <div style="text-align: center; margin: 15px 0;">
          <div id="distance-value" style="font-size: 2.5rem; font-weight: bold;">-- cm</div>
          <div id="distance-sub" style="font-size: 0.9rem; color: var(--text-muted);">-- mm</div>
        </div>
        <div class="control-group">
          <label>Umbral de Seguridad (cm)</label>
          <input type="number" id="safety-distance" value="15" min="5" max="100" onchange="updateSafetyDistance(this.value)">
        </div>
        <div id="distance-alert" class="distance-alert">Camino Despejado</div>
      </div>

    </div>

    <!-- Parada de Emergencia -->
    <button class="btn btn-danger btn-lg" onclick="emergencyStop()">
      🛑 PARADA DE EMERGENCIA (E-STOP)
    </button>
  </div>

  <!-- TAB CONFIGURACIÓN MAPEO -->
  <div id="tab-config" class="tab-content">
    <div class="card">
      <div class="card-title">Configuración de Parámetros y Asignación de Botones</div>
      <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:15px;">
        Asigna manualmente los índices detected en la Gamepad API para tu mando Diswoe SW-01.
      </p>
      
      <div class="control-group">
        <label>Zona Muerta Joystick (0.05 a 0.40)</label>
        <input type="range" id="deadzone-range" min="0.05" max="0.40" step="0.01" value="0.15" oninput="document.getElementById('deadzone-val').innerText = this.value">
        <span id="deadzone-val">0.15</span>
      </div>

      <div class="mapping-grid">
        <div class="btn-map-item">
          <span>Subir Mecanismo (Digital):</span>
          <input type="number" id="map-btn-up" value="0" style="width:60px;">
        </div>
        <div class="btn-map-item">
          <span>Bajar Mecanismo (Digital):</span>
          <input type="number" id="map-btn-down" value="1" style="width:60px;">
        </div>
        <div class="btn-map-item">
          <span>Modo Lento (X):</span>
          <input type="number" id="map-btn-slow" value="2" style="width:60px;">
        </div>
        <div class="btn-map-item">
          <span>Modo Rápido (Y):</span>
          <input type="number" id="map-btn-fast" value="3" style="width:60px;">
        </div>
        <div class="btn-map-item">
          <span>Parada Inmediata (RT):</span>
          <input type="number" id="map-btn-stop" value="7" style="width:60px;">
        </div>
        <div class="btn-map-item">
          <span>Botón TURBO:</span>
          <input type="number" id="map-btn-turbo" value="8" style="width:60px;">
        </div>
      </div>
    </div>
  </div>

  <!-- TAB DIAGNÓSTICO & BRIDGE -->
  <div id="tab-diag" class="tab-content">
    <div class="grid-container">
      <div class="card">
        <div class="card-title">Raw Gamepad API Diagnostic</div>
        <div id="gamepad-raw-info" style="font-family: monospace; font-size: 0.8rem; white-space: pre-wrap;">
          Pulsa cualquier botón del mando para detectar ejes e índices...
        </div>
      </div>
      <div class="card">
        <div class="card-title">Consola de Comunicación / Registros</div>
        <div id="system-logs" class="logs-container"></div>
      </div>
    </div>

    <div class="card" style="margin-top:20px;">
      <div class="card-title">Código Python Requerido en el LEGO Hub (Bridge SSP)</div>
      <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:10px;">
        Si el Hub requiere un script puente RPC para ejecutar los comandos por JSON/TunnelMessage, asegúrate de que tiene cargado este programa en ejecucion:
      </p>
      <div class="code-block">import hub, utime, json, sys

# SPIKE Prime Bridge Script
def run():
    while True:
        try:
            line = sys.stdin.readline()
            if line:
                req = json.loads(line)
                cmd = req.get("cmd")
                # Ejecución de comandos del motor
                if cmd == "motor.run":
                    port = getattr(hub.port, req["port"])
                    port.motor.run_at_speed(req["speed"])
                elif cmd == "motor.stop":
                    port = getattr(hub.port, req["port"])
                    port.motor.brake()
                elif cmd == "sensor.read":
                    dist = hub.port.F.device.get()[0] if hub.port.F.device else -1
                    print(json.dumps({"type": "sensor", "port": "F", "value": dist}))
        except Exception as e:
            pass
        utime.sleep_ms(20)

run()</div>
    </div>
  </div>

  <script>
    // --- ESTADO Y CONFIGURACIÓN GLOBAL ---
    const BLE_SERVICE_UUID = '0000fd02-0000-1000-8000-00805f9b34fb';
    const BLE_RX_UUID      = '0000fd02-0001-1000-8000-00805f9b34fb'; // Write without response
    const BLE_TX_UUID      = '0000fd02-0002-1000-8000-00805f9b34fb'; // Notify

    let bleDevice = null;
    let rxCharacteristic = null;
    let txCharacteristic = null;
    let isHubConnected = false;

    let gamepadIndex = null;
    let gamepadPollingInterval = null;

    let maxSpeedMultiplier = 0.7;
    let deadzone = 0.15;
    let safetyDistanceCm = 15;
    let obstacleDetected = false;

    // Estado previo para evitar transmisiones BLE redundantes
    let lastSentLeft = 0;
    let lastSentRight = 0;
    let lastSentE = 0;

    // Log helper
    function log(msg, type = 'default') {
      const logsContainer = document.getElementById('system-logs');
      const entry = document.createElement('div');
      entry.className = `log-entry ${type}`;
      entry.innerText = `[${new Date().toLocaleTimeString()}] ${msg}`;
      logsContainer.appendChild(entry);
      logsContainer.scrollTop = logsContainer.scrollHeight;
    }

    function switchTab(tabId) {
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
      
      event.target.classList.add('active');
      document.getElementById(`tab-${tabId}`).classList.add('active');
    }

    // --- ENCODER / DECODER COBS Y FRAMING PARA SPIKE PRIME ---
    function cobsEncode(buf) {
      let src = new Uint8Array(buf);
      let dst = [];
      let codeIndex = 0;
      let code = 1;
      dst.push(0);

      for (let i = 0; i < src.length; i++) {
        if (src[i] === 0) {
          dst[codeIndex] = code;
          codeIndex = dst.length;
          dst.push(0);
          code = 1;
        } else {
          dst.push(src[i]);
          code++;
          if (code === 0xFF) {
            dst[codeIndex] = code;
            codeIndex = dst.length;
            dst.push(0);
            code = 1;
          }
        }
      }
      dst[codeIndex] = code;
      return new Uint8Array(dst);
    }

    function buildFrame(payloadString) {
      let payload = new TextEncoder().encode(payloadString);
      // Framing XOR Masking / Frame Boundary según especifición BLE de SPIKE
      let encoded = cobsEncode(payload);
      let frame = new Uint8Array(encoded.length + 1);
      frame.set(encoded, 0);
      frame[encoded.length] = 0x00; // Frame Delimiter
      return frame;
    }

    // --- COMUNICACIÓN WEB BLUETOOTH ---
    async function connectHub() {
      try {
        log('Iniciando búsqueda de LEGO SPIKE Prime Hub...', 'info');
        bleDevice = await navigator.bluetooth.requestDevice({
          filters: [{ namePrefix: 'LEGO' }],
          optionalServices: [BLE_SERVICE_UUID]
        });

        bleDevice.addEventListener('gattserverdisconnected', onHubDisconnected);

        log('Conectando al servidor GATT...', 'info');
        const server = await bleDevice.gatt.connect();

        log('Obteniendo servicio SPIKE BLE...', 'info');
        const service = await server.getPrimaryService(BLE_SERVICE_UUID);

        rxCharacteristic = await service.getCharacteristic(BLE_RX_UUID);
        txCharacteristic = await service.getCharacteristic(BLE_TX_UUID);

        await txCharacteristic.startNotifications();
        txCharacteristic.addEventListener('characteristicvaluechanged', handleHubNotification);

        isHubConnected = true;
        document.getElementById('hub-status').innerText = 'HUB BLE: Conectado';
        document.getElementById('hub-status').className = 'status-badge connected';
        log('Conexión con SPIKE Prime establecida con éxito', 'success');

        // Bucle de solicitud periódico del sensor F
        setInterval(queryDistanceSensor, 200);

      } catch (error) {
        log(`Error al conectar con el Hub: ${error.message}`, 'error');
      }
    }

    function onHubDisconnected() {
      isHubConnected = false;
      document.getElementById('hub-status').innerText = 'HUB BLE: Desconectado';
      document.getElementById('hub-status').className = 'status-badge disconnected';
      log('Hub desconectado de forma imprevista', 'error');
      emergencyStop();
    }

    async function sendCommand(jsonObj) {
      if (!isHubConnected || !rxCharacteristic) return;
      try {
        const payloadStr = JSON.stringify(jsonObj) + '\n';
        const frame = buildFrame(payloadStr);
        await rxCharacteristic.writeValueWithoutResponse(frame);
      } catch (err) {
        log(`Error en transmisión BLE: ${err.message}`, 'error');
      }
    }

    function handleHubNotification(event) {
      try {
        let value = event.target.value;
        let dec = new TextDecoder().decode(value);
        // Procesar posibles respuestas JSON provenientes del bridge
        if (dec.includes('"type": "sensor"')) {
          let data = JSON.parse(dec);
          if (data.port === 'F') {
            updateDistanceUI(data.value);
          }
        }
      } catch (e) {
        // Ignorar tramas parciales o ruidos no correspondientes a JSON
      }
    }

    function queryDistanceSensor() {
      if (isHubConnected) {
        sendCommand({ cmd: "sensor.read", port: "F" });
      }
    }

    // --- GAMEPAD API (DISWOE SW-01) ---
    function toggleGamepadDetection() {
      window.addEventListener("gamepadconnected", (e) => {
        gamepadIndex = e.gamepad.index;
        log(`Mando detectado: ${e.gamepad.id}`, 'success');
        document.getElementById('gamepad-status').innerText = 'Mando: Conectado';
        document.getElementById('gamepad-status').className = 'status-badge connected';
        startGamepadLoop();
      });

      window.addEventListener("gamepaddisconnected", (e) => {
        log(`Mando desconectado del índice ${e.gamepad.index}`, 'error');
        document.getElementById('gamepad-status').innerText = 'Mando: Desconectado';
        document.getElementById('gamepad-status').className = 'status-badge disconnected';
        emergencyStop();
      });

      log('Esperando interacción con el mando Diswoe SW-01...', 'info');
    }

    function startGamepadLoop() {
      if (!gamepadPollingInterval) {
        gamepadPollingInterval = setInterval(pollGamepad, 50);
      }
    }

    function pollGamepad() {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      if (gamepadIndex === null || !gamepads[gamepadIndex]) return;

      const gp = gamepads[gamepadIndex];
      deadzone = parseFloat(document.getElementById('deadzone-range').value);

      // Actualizar Diagnóstico Raw
      document.getElementById('gamepad-raw-info').innerText = 
        `ID: ${gp.id}\n` +
        `Ejes: ${gp.axes.map((a, i) => `\n Axis ${i}: ${a.toFixed(3)}`).join('')}\n\n` +
        `Botones: ${gp.buttons.map((b, i) => `\n Btn ${i}: ${b.pressed ? 'PRESIONADO' : 'libre'}`).join('')}`;

      // Procesamiento Joysticks con Filtro Zona Muerta
      let rawLX = gp.axes[0] || 0;
      let rawLY = gp.axes[1] || 0;
      let rawRY = gp.axes[3] !== undefined ? gp.axes[3] : (gp.axes[2] || 0);

      let lx = Math.abs(rawLX) > deadzone ? rawLX : 0;
      let ly = Math.abs(rawLY) > deadzone ? rawLY : 0;
      let ry = Math.abs(rawRY) > deadzone ? rawRY : 0;

      updateJoystickVisual('stick-left', lx, ly);
      updateJoystickVisual('stick-right', 0, ry);

      // Botones mapeados
      const btnUp = gp.buttons[parseInt(document.getElementById('map-btn-up').value)]?.pressed;
      const btnDown = gp.buttons[parseInt(document.getElementById('map-btn-down').value)]?.pressed;
      const btnSlow = gp.buttons[parseInt(document.getElementById('map-btn-slow').value)]?.pressed;
      const btnFast = gp.buttons[parseInt(document.getElementById('map-btn-fast').value)]?.pressed;
      const btnStop = gp.buttons[parseInt(document.getElementById('map-btn-stop').value)]?.pressed;

      if (btnStop) {
        emergencyStop();
        return;
      }

      if (btnSlow) updateSpeedMode(0.4);
      if (btnFast) updateSpeedMode(1.0);

      // Algoritmo Conducción Diferencial
      // ly negativo es AVANZAR, positivo es RETROCEDER
      let drive = -ly;
      let turn = lx;

      // Frenado automático si hay obstáculo y se intenta avanzar
      if (obstacleDetected && drive > 0 && document.getElementById('auto-brake-check').checked) {
        drive = 0;
      }

      let leftSpeed = (drive + turn) * maxSpeedMultiplier * 100;
      let rightSpeed = (drive - turn) * maxSpeedMultiplier * 100;

      // Normalización para no superar [-100, 100]
      let maxMag = Math.max(Math.abs(leftSpeed), Math.abs(rightSpeed));
      if (maxMag > 100) {
        leftSpeed = (leftSpeed / maxMag) * 100 * maxSpeedMultiplier;
        rightSpeed = (rightSpeed / maxMag) * 100 * maxSpeedMultiplier;
      }

      // Motor Mecanismo E
      let speedE = 0;
      if (Math.abs(ry) > 0) {
        speedE = -ry * maxSpeedMultiplier * 100;
      } else if (btnUp) {
        speedE = 50 * maxSpeedMultiplier;
      } else if (btnDown) {
        speedE = -50 * maxSpeedMultiplier;
      }

      // Actualizar UI
      updateMotorGauges(leftSpeed, rightSpeed, speedE);

      // Enviar a los motores solo si cambian los valores
      sendMotorCommands(Math.round(leftSpeed), Math.round(rightSpeed), Math.round(speedE));
    }

    function updateJoystickVisual(elementId, x, y) {
      const handle = document.getElementById(elementId);
      const maxOffset = 40;
      handle.style.transform = `translate(${x * maxOffset}px, ${y * maxOffset}px)`;
    }

    function updateMotorGauges(left, right, e) {
      document.getElementById('val-motor-left').innerText = `${Math.round(left)}%`;
      document.getElementById('bar-motor-left').style.width = `${Math.abs(left)}%`;

      document.getElementById('val-motor-right').innerText = `${Math.round(right)}%`;
      document.getElementById('bar-motor-right').style.width = `${Math.abs(right)}%`;

      document.getElementById('val-motor-e').innerText = `${Math.round(e)}%`;
      document.getElementById('bar-motor-e').style.width = `${Math.abs(e)}%`;
    }

    // --- ENVIAR INSTRUCCIONES AL HUB ---
    function sendMotorCommands(left, right, speedE) {
      if (!isHubConnected) return;

      // Motores A y C (Izquierda)
      if (left !== lastSentLeft) {
        if (left === 0) {
          sendCommand({ cmd: "motor.stop", port: "A" });
          sendCommand({ cmd: "motor.stop", port: "C" });
        } else {
          sendCommand({ cmd: "motor.run", port: "A", speed: left });
          sendCommand({ cmd: "motor.run", port: "C", speed: left });
        }
        lastSentLeft = left;
      }

      // Motores B y D (Derecha)
      if (right !== lastSentRight) {
        if (right === 0) {
          sendCommand({ cmd: "motor.stop", port: "B" });
          sendCommand({ cmd: "motor.stop", port: "D" });
        } else {
          sendCommand({ cmd: "motor.run", port: "B", speed: right });
          sendCommand({ cmd: "motor.run", port: "D", speed: right });
        }
        lastSentRight = right;
      }

      // Motor E (Mecanismo)
      if (speedE !== lastSentE) {
        if (speedE === 0) {
          sendCommand({ cmd: "motor.stop", port: "E" });
        } else {
          sendCommand({ cmd: "motor.run", port: "E", speed: speedE });
        }
        lastSentE = speedE;
      }
    }

    // --- SENSOR DE DISTANCIA Y PARADA DE SEGURIDAD ---
    function updateDistanceUI(valueMm) {
      const distMmElem = document.getElementById('distance-sub');
      const distCmElem = document.getElementById('distance-value');
      const alertElem = document.getElementById('distance-alert');

      if (valueMm === null || valueMm < 0 || valueMm > 2000) {
        distCmElem.innerText = "-- cm";
        distMmElem.innerText = "Sin objeto detectado";
        alertElem.className = "distance-alert";
        alertElem.innerText = "Camino Despejado";
        obstacleDetected = false;
        return;
      }

      let cm = (valueMm / 10).toFixed(1);
      distCmElem.innerText = `${cm} cm`;
      distMmElem.innerText = `${valueMm} mm`;

      if (parseFloat(cm) <= safetyDistanceCm) {
        alertElem.className = "distance-alert active";
        alertElem.innerText = "⚠️ ¡OBSTÁCULO CERCANO! ADVERTENCIA";
        obstacleDetected = true;
      } else {
        alertElem.className = "distance-alert";
        alertElem.innerText = "Camino Despejado";
        obstacleDetected = false;
      }
    }

    function updateSpeedMode(val) {
      maxSpeedMultiplier = parseFloat(val);
      document.getElementById('speed-mode').value = val;
    }

    function updateSafetyDistance(val) {
      safetyDistanceCm = parseFloat(val);
    }

    function emergencyStop() {
      log('🛑 PARADA DE EMERGENCIA ACTIVADA', 'error');
      lastSentLeft = 0;
      lastSentRight = 0;
      lastSentE = 0;
      updateMotorGauges(0, 0, 0);

      if (isHubConnected) {
        ['A', 'B', 'C', 'D', 'E'].forEach(port => {
          sendCommand({ cmd: "motor.stop", port: port });
        });
      }
    }
  </script>
</body>
